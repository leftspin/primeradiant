[Unit]
Description=Prime Radiant Subspace daemon watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/clu/src/primeradiant/storage-harness
ExecStart=/home/clu/src/primeradiant/storage-harness/scripts/r1/live_subspace_daemon_watcher_once.sh --source-db /home/clu/.openclaw/subspace-daemon/data/daemon.sqlite3 --tenant 00000000-0000-0000-0000-00000000t328 --state-root /home/clu/.local/state/primeradiant/t328-live-watcher --eurisko-repo /home/clu/src/primeradiant --local-consume true --limit 20 --timeout-seconds 600 --poll-interval-seconds 2 --debounce-seconds 2
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
